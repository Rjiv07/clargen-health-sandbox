# Local Medplum development server
CLARGEN_MEDPLUM_BASE_URL=http://localhost:8103

# Set interactively in your shell for provisioning; do not save real tokens here.
# CLARGEN_MEDPLUM_ACCESS_TOKEN=

# Dedicated ClientApplication credentials are required only for the opt-in
# integration test. Store real values in an untracked .env file or secret store.
# CLARGEN_IDENTITY_ISSUER_CLIENT_ID=
# CLARGEN_IDENTITY_ISSUER_CLIENT_SECRET=

# Used by a host application that mounts createIdentityHttpServer().
# Authentication must validate this token and create caller-scoped services.
# Do not use the administrator or issuer secret as a browser bearer token.
# CLARGEN_API_PORT=8080
