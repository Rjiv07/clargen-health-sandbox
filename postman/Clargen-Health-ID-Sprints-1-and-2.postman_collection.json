{
  "info": {
    "name": "Clargen Health ID - Sprints 1 and 2",
    "description": "Local individual signup, signin, session and own-profile API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "healthId", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Signup and issue Health ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('healthId', body.healthId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"givenName\": \"Asha\",\n  \"familyName\": \"Rao\",\n  \"dateOfBirth\": \"1998-04-16\",\n  \"email\": \"asha.rao@example.com\",\n  \"mobile\": \"+919876543210\",\n  \"password\": \"A-long-local-test-passphrase-2026\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/signup"
      }
    },
    {
      "name": "Signin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', body.accessToken);",
              "  pm.collectionVariables.set('healthId', body.healthId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"asha.rao@example.com\",\n  \"password\": \"A-long-local-test-passphrase-2026\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/signin"
      }
    },
    {
      "name": "Get my profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/me"
      }
    },
    {
      "name": "Get own profile by Health ID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/individuals/health-id/{{healthId}}"
      }
    },
    {
      "name": "Signout and revoke token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/v1/signout"
      }
    }
  ]
}